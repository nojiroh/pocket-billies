From bd41b95c94d301141c3958fbb437284455947f76 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 09:43:58 +0000
Subject: [PATCH 03/22] Tools: to-module.mjs keeps a comment that follows the
 generated part where it is

The generated part was put after all the leading comments of the file once its old copy was cut out, so a comment
right under /* to-module: end */ (a JSDoc type on the first declaration, say) moved above the part on the next run
(and check:modules called the file out of date). It now goes back where it was. No module changes (75, 0 changed).
---
 tools/to-module.mjs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/to-module.mjs b/tools/to-module.mjs
index 34d461e..7ed318e 100644
--- a/tools/to-module.mjs
+++ b/tools/to-module.mjs
@@ -408,7 +408,9 @@ export async function run(args) {
     ];
     let body = text;
     for (const [at, str] of edits.sort((a, b) => b[0] - a[0])) body = body.slice(0, at) + str + body.slice(at);
-    const h = headerEnd(body);
+    // the generated part goes where it was (a comment right after it stays below it), else after the leading comments
+    const was = raw.indexOf(START);
+    const h = was >= 0 ? was : headerEnd(body);
     const head = body.slice(0, h).replace(/\s*$/, '');
     let out = (head ? head + '\n' : '') + lines.join('\n') + '\n' + body.slice(h).replace(/^\s*\n/, '');
     await write(f, out, raw);
