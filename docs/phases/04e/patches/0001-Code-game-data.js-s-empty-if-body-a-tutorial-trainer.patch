From 0e89e079ebc6e99460611ff4cf7ac4acb67995c1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 09:43:57 +0000
Subject: [PATCH 01/22] Code: game-data.js's empty if body (a tutorial trainer)
 is a block

TypeScript refuses an if whose body is an empty statement in a checked file (TS1313); a block with a comment does
the same. No behaviour change (the only difference in the syntax tree is EmptyStatement -> an empty BlockStatement).
---
 game/js/game-data.js | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/game/js/game-data.js b/game/js/game-data.js
index df89fde..ce8fe85 100644
--- a/game/js/game-data.js
+++ b/game/js/game-data.js
@@ -298,8 +298,9 @@ export const TRAINERS = gameData.trainers || {};
 for (const id in TRAINERS) {
   const T = TRAINERS[id];
   T.id = id;
-  if (T.tutorial);
-  else if (LOCATIONS[T.node]) LOCATIONS[T.node].trainers.push(id);
+  if (T.tutorial) {
+    /* it waits on no location */
+  } else if (LOCATIONS[T.node]) LOCATIONS[T.node].trainers.push(id);
   else warnData(`Trainer ${id} stands on a stop that doesn’t exist.`);
   if (!PEOPLE[T.who]) T.who = 'gini';
   T.team = (T.team || []).filter(
