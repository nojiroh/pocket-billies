From 0981e4a70d485f0246e7cbe2473fb885611a34bf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 09:43:59 +0000
Subject: [PATCH 10/22] CI: the type check in the lint job (npm run typecheck,
 about a second)

---
 .github/workflows/check.yml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/.github/workflows/check.yml b/.github/workflows/check.yml
index c9689d6..6e1def4 100644
--- a/.github/workflows/check.yml
+++ b/.github/workflows/check.yml
@@ -7,6 +7,7 @@
 # - Phase 04a: lint (ESLint: undefined names, names defined twice across scripts, recommended bug rules), the Prettier
 #   format check and the Vite build on every push and pull request, about a minute. ESLint replaces check-globals.py.
 #   Phase 04b: the game data check (tools/check-data.mjs: the files index.json lists, their schemas, references).
+#   Phase 04e: the type check (npm run typecheck: TypeScript on the files that start with // @ts-check, a second).
 # - Phase 03: the picture baseline is made on this runner (the pictures depend on the renderer) and kept as the asset
 #   quick-baseline.zip of the release baseline-<version> (version from game/version.js, e.g. baseline-0.1.0-alpha).
 #   It is made on phase-* tags and by hand (Run workflow with "Make the picture baseline"); every other full run
@@ -90,6 +91,8 @@ jobs:
         run: npm ci
       - name: Lint
         run: npm run lint
+      - name: Types (the files that start with // @ts-check, against game/types)
+        run: npm run typecheck
       - name: Game data (files, schemas, references)
         run: npm run check:data
       - name: Modules (generated imports, hooks.js and debug-log-names.js up to date; load order)
