{
  "name": "pocket-billies",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "node tools/build-data.mjs",
    "check:data": "node tools/check-data.mjs",
    "lint:ui": "node tools/ui-lint.mjs",
    "story:ids": "node tools/story-ids.mjs",
    "modules": "node tools/to-module.mjs",
    "check:modules": "node tools/to-module.mjs --check",
    "lint": "eslint --cache --cache-strategy content . && node tools/check-names.mjs && node tools/ui-lint.mjs --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.logic.json",
    "test": "node --test \"tools/test/**/*.test.mjs\"",
    "check:logic": "npm test",
    "format": "prettier --write \"game/**/*.{js,css,ts}\" \"studio/**/*.{js,css}\" \"tools/test/**/*.mjs\" \"*.js\"",
    "format:check": "prettier --check \"game/**/*.{js,css,ts}\" \"studio/**/*.{js,css}\" \"tools/test/**/*.mjs\" \"*.js\"",
    "check:fast": "python3 tools/check-fast.py",
    "check:smoke": "python3 tools/check-quick.py --smoke",
    "check:ui": "python3 tools/check-ui-gallery.py",
    "check:quick": "python3 tools/check-quick.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.17.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "lit": "3.3.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
