rules_version = '2';
// Pocket Billies: Firestore rules. This file is the one copy; paste it into Firebase → Firestore Database → Rules and
// press Publish. Tested by firebase/test/rules.test.mjs on the emulator (cd firebase && npm ci && npm test).
//
// What each collection holds (js/account.js, js/friends.js):
//   saves/<uid>             one player's save, private: { json, savedAt, saveVersion, name, game, t }
//   users/<uid>             what friends see of a player: name, look, partner, last place, friend list, code
//   codes/<CODE>            { uid }: a friend code finds a player, and nothing else does
//   requests/<from>_<to>    a friend request: { from, to, fromName, status, t }
//   blocks/<uid>            ON-1: the players this one blocked: { list, names }, read by nobody else
//   reports/<target>        ON-1: { n, ok }: how many accounts reported a target ('user_<uid>'), each once
//                           (reports/<target>/by/<uid>: { reason, t }), and up to which count the moderator cleared
//   ghosts/<uid>            ON-2: { name, last, day, week, x, fast }: the last run (a friend's ghost) and the board
//                           entries, read by the owner's friends
//   showcase/<uid>_<slot>   ON-3: one shared Billie's look (slot 0-2, so at most 3 a player): { u, name, sp, coat,
//                           build, graft, aug, abom, lvl, nick, ot, th, w, k, v, wv, r, ok, hid }, listed by anyone
//                           signed in, 20 at a time
//   votes/<entry>_<k>_<uid> ON-3: one account's vote on one entry ({ e, k, by, t }); the entry's v goes up by one in
//                           the same batch, and down by one when the vote is taken back
//   offers/<a>_<b>          ON-4: a trade between two friends (a < b): what each side gives, each side's ok on the
//                           offer's version, gave / received / took back marks; read by the two players only
// Nobody can list users/ or codes/, so a player is found by their code only, and only their friends see them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function shortText(v, n) { return v is string && v.size() <= n; }
    // ON-1: the moderator reads reports and clears them. Paste your own Firebase uid here before you publish (the debug
    // menu shows it under Save when you're signed in); the rules tests read whatever stands here.
    function moderator() { return signedIn() && me() in ['PASTE-YOUR-UID-HERE']; }
    // ON-1: `who` is on `by`'s block list
    function blocked(by, who) {
      return exists(/databases/$(database)/documents/blocks/$(by))
        && who in get(/databases/$(database)/documents/blocks/$(by)).data.list;
    }

    // RL-10b: only the keys the game writes, and t is the server's time of this write (serverTimestamp()), the ranch
    // clock's anchor (js/logic/ranch-clock.js): a phone clock behind the last save's t is a clock turned back.
    match /saves/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['json', 'savedAt', 'saveVersion', 'name', 'game', 't'])
        && request.resource.data.t == request.time
        && request.resource.data.json is string && request.resource.data.json.size() < 1000000;
    }

    // users/<uid>.friends is the owner's own list: being on it lets that friend read this document. A player can
    // only add people to their own list, so it never gives them a way into someone else's.
    match /users/{uid} {
      allow get: if signedIn() && (me() == uid || me() in resource.data.get('friends', []));
      allow create, update: if signedIn() && me() == uid && validUser(request.resource.data);
      allow delete: if signedIn() && me() == uid;
    }
    function validUser(d) {
      return d.keys().hasOnly(['name', 'avatar', 'partner', 'at', 'v', 'friends', 'code'])
        && (!('name' in d) || shortText(d.name, 40))
        && (!('friends' in d) || (d.friends is list && d.friends.size() <= 50))
        && (!('code' in d) || shortText(d.code, 8))
        && (!('partner' in d) || d.partner == null || d.partner is map)
        && (!('avatar' in d) || d.avatar == null || d.avatar is map)
        && (!('at' in d) || d.at is map);
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
    }

    // The sender asks (pending) or takes it back (removed); only the receiver accepts or declines.
    match /requests/{id} {
      function party(d) { return d.from == me() || d.to == me(); }
      allow get: if signedIn() && (resource == null || party(resource.data));
      allow list: if signedIn() && party(resource.data);
      allow delete: if signedIn() && party(resource.data);
      allow create: if signedIn() && validRequest(request.resource.data)
        && request.resource.data.from == me() && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && !blocked(request.resource.data.to, me());
      allow update: if signedIn() && party(resource.data) && validRequest(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 't', 'fromName'])
        && ((me() == resource.data.to && request.resource.data.status in ['accepted', 'declined', 'removed'])
          || (me() == resource.data.from && request.resource.data.status == 'removed')
          || (me() == resource.data.from && request.resource.data.status == 'pending' && !blocked(resource.data.to, me())));
    }
    // ON-1: the owner's block list. Only its owner reads it; the request rules above read it to refuse a blocked player.
    match /blocks/{uid} {
      allow get, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['list', 'names'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 200
        && (!('names' in request.resource.data) || (request.resource.data.names is map
          && request.resource.data.names.size() <= 200));
    }

    // ON-1: reports. A target's count goes up by exactly one with each account's first report (the count and the
    // reporter's own document in one batch, each checking the other); anyone signed in reads the count (the game hides
    // a target 3 reports past `ok`), only the moderator reads who reported and why, and only the moderator raises `ok`.
    match /reports/{target} {
      function count() { return get(/databases/$(database)/documents/reports/$(target)).data.n; }
      function firstReport() {
        return !exists(/databases/$(database)/documents/reports/$(target)/by/$(me()))
          && existsAfter(/databases/$(database)/documents/reports/$(target)/by/$(me()));
      }
      allow get: if signedIn();
      allow list: if moderator();
      allow create: if signedIn() && target.matches('^(user_[A-Za-z0-9]{1,128}|show_[A-Za-z0-9]{1,128}_[0-2]_[0-9]{1,16})$')
        && !target.matches('^(user|show)_' + me() + '(_.*)?$')
        && request.resource.data.keys().hasOnly(['n', 'ok'])
        && request.resource.data.n == 1 && request.resource.data.ok == 0 && firstReport();
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
          && request.resource.data.n == resource.data.n + 1 && firstReport())
        || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok'])
          && request.resource.data.ok is int && request.resource.data.ok >= resource.data.ok
          && request.resource.data.ok <= resource.data.n));
      match /by/{uid} {
        allow get, list: if moderator();
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['reason', 't'])
          && request.resource.data.reason in ['name', 'picture', 'cheating', 'other']
          && request.resource.data.t is number
          && getAfter(/databases/$(database)/documents/reports/$(target)).data.n
            == (exists(/databases/$(database)/documents/reports/$(target)) ? count() + 1 : 1);
      }
    }

    // ON-2: a player's last run (their ghost, the record as JSON text, at most 8 KB) and their friends' board entries
    // (js/boards.js, js/logic/run-record.js), written by its owner alone; read by the owner and the friends on the
    // owner's own list, as users/<uid> is; never listed. A daily's (day) or weekly's (week) entry goes in only for the
    // server's day or week, or the one before, and can't change once in. Spark has no server to replay a run, so a
    // friend could post a faked entry within these caps (docs/SECURITY.md).
    match /ghosts/{uid} {
      allow get: if signedIn() && (me() == uid
        || me() in get(/databases/$(database)/documents/users/$(uid)).data.get('friends', []));
      allow delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && validGhost(request.resource.data);
    }
    // the UTC day number (0 = 1970-01-01) and week number (weeks from Monday 00:00 UTC), as js/logic/daily.js
    function today() { return math.floor(request.time.toMillis() / 86400000); }
    function thisWeek() { return math.floor((today() + 3) / 7); }
    function validEntry(e) {
      return e is map && e.keys().hasOnly(['won', 'cleared', 'leaders', 'days', 'exp', 'lead', 't'])
        && e.size() == 7
        && e.won in [0, 1]
        && e.cleared is int && e.cleared >= 0 && e.cleared <= 40
        && e.leaders is int && e.leaders >= 0 && e.leaders <= 16
        && e.days is int && e.days >= 1 && e.days <= 999
        && e.exp is int && e.exp >= 1 && e.exp <= 9
        && shortText(e.lead, 64)
        && e.t is number;
    }
    // a day's or week's entry: { n, e }, n this one or the one before, or as it already stood
    function dated(d, k, now) {
      return !(k in d) || (d[k] is map && d[k].keys().hasOnly(['n', 'e']) && d[k].n is int && validEntry(d[k].e)
        && (resource != null && k in resource.data && resource.data[k].n == d[k].n
          ? resource.data[k] == d[k]
          : (d[k].n == now || d[k].n == now - 1)));
    }
    function bestOk(x, k) { return !(k in x) || validEntry(x[k]); }
    function validGhost(d) {
      return d.keys().hasOnly(['name', 'last', 'day', 'week', 'x', 'fast'])
        && shortText(d.name, 40)
        && d.last is string && d.last.size() <= 8192
        && dated(d, 'day', today()) && dated(d, 'week', thisWeek())
        && (!('fast' in d) || validEntry(d.fast))
        && (!('x' in d) || (d.x is map && d.x.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7', '8', '9'])
          && bestOk(d.x, '1') && bestOk(d.x, '2') && bestOk(d.x, '3') && bestOk(d.x, '4') && bestOk(d.x, '5')
          && bestOk(d.x, '6') && bestOk(d.x, '7') && bestOk(d.x, '8') && bestOk(d.x, '9')));
    }

    // ON-3: the Showcase (js/showcase.js, js/logic/showcase.js). An entry is a Billie's look only (nothing of value
    // moves): its owner makes it (one of three slots) and deletes it, never edits it. Anyone signed in lists entries,
    // 20 at a time. Votes: votes/<entry>_<k>_<voter> is made once (k: the entry's own stamp, so a replaced entry starts
    // again) in one batch with the entry's v + 1 (and wv, the week's sort key, for an entry in the week's theme), each
    // checking the other, as reports do; never on your own entry, only in the entry's own week. Taking a vote back is
    // the same batch with - 1. A report on an entry also raises its r (the game hides an entry 3 reports past ok); the
    // moderator raises ok or sets hid. Spark has no server: one person with several accounts can vote several times.
    match /showcase/{id} {
      function voteAt(e) {
        return /databases/$(database)/documents/votes/$(id + '_' + string(e.k) + '_' + me());
      }
      function reportAt(e) {
        return /databases/$(database)/documents/reports/$('show_' + id + '_' + string(e.k))/by/$(me());
      }
      function step(o, n, k) {
        return n.v == o.v + k && n.v >= 0 && n.wv == o.wv + (o.wv > 0 ? k : 0);
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow delete: if signedIn() && resource.data.u == me();
      allow create: if signedIn() && id in [me() + '_0', me() + '_1', me() + '_2']
        && validShow(request.resource.data) && request.resource.data.u == me()
        && request.resource.data.v == 0 && request.resource.data.r == 0 && request.resource.data.ok == 0
        && !('hid' in request.resource.data)
        && request.resource.data.w == thisWeek()
        && request.resource.data.wv == (request.resource.data.th == '' ? 0 : request.resource.data.w * 1000000);
      allow update: if signedIn() && (
        (resource.data.u != me() && resource.data.w == thisWeek() && !resource.data.get('hid', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v', 'wv'])
          && ((step(resource.data, request.resource.data, 1)
              && !exists(voteAt(resource.data)) && existsAfter(voteAt(resource.data)))
            || (step(resource.data, request.resource.data, -1)
              && exists(voteAt(resource.data)) && !existsAfter(voteAt(resource.data)))))
        || (resource.data.u != me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
          && request.resource.data.r == resource.data.r + 1
          && !exists(reportAt(resource.data)) && existsAfter(reportAt(resource.data)))
        || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok', 'hid'])
          && request.resource.data.ok is int && request.resource.data.ok >= resource.data.ok
          && request.resource.data.ok <= request.resource.data.r
          && request.resource.data.get('hid', false) is bool));
    }
    function validShow(d) {
      return d.keys().hasOnly(['u', 'name', 'sp', 'coat', 'build', 'graft', 'aug', 'abom', 'lvl', 'nick', 'ot', 'th',
          'w', 'k', 'v', 'wv', 'r', 'ok'])
        && shortText(d.name, 40) && shortText(d.sp, 32) && shortText(d.nick, 16) && shortText(d.ot, 40)
        && shortText(d.th, 32)
        && (!('coat' in d) || shortText(d.coat, 32))
        && (!('build' in d) || (d.build is map && d.build.size() <= 8))
        && (!('graft' in d) || (d.graft is map && d.graft.size() <= 8))
        && (!('aug' in d) || (d.aug is map && d.aug.size() <= 2))
        && d.abom is bool
        && d.lvl is int && d.lvl >= 1 && d.lvl <= 100
        && d.k is int && d.k > 0 && d.w is int && d.v is int && d.wv is int && d.r is int && d.ok is int;
    }
    match /votes/{id} {
      function entry(v) { return /databases/$(database)/documents/showcase/$(v.e); }
      allow get: if signedIn() && (resource == null || resource.data.by == me());
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['e', 'k', 'by', 't'])
        && request.resource.data.by == me() && request.resource.data.e is string
        && request.resource.data.k is int && request.resource.data.t is number
        && id == request.resource.data.e + '_' + string(request.resource.data.k) + '_' + me()
        && get(entry(request.resource.data)).data.k == request.resource.data.k
        && getAfter(entry(request.resource.data)).data.v == get(entry(request.resource.data)).data.v + 1;
      allow delete: if signedIn() && resource.data.by == me()
        && (!exists(entry(resource.data)) || get(entry(resource.data)).data.k != resource.data.k
          || getAfter(entry(resource.data)).data.v == get(entry(resource.data)).data.v - 1);
    }

    // ON-4: a trade between two friends (js/trade.js, js/logic/trade.js). One live offer per pair, offers/<a>_<b> with
    // a < b; side 'a' or 'b' is which of the two you are. Each side writes only its own fields. The steps:
    //   1 my give (up to 3 things, each an online copy as JSON text) changes: the version v goes up, so no ok stands
    //   2 my ok: the version I agreed to (o_ == v), or 0 to take it back; both oks on v lock the gives
    //   3 I gave (d_): only when locked, with my save written in the same batch (its t is this write's time)
    //   4 I received (r_): only after both gave, with my save in the same batch
    //   closing: cancel while nobody gave; refused (what came failed the game's check) while they haven't received;
    //   stale when I gave 7 days ago and they never did; then a side that gave takes its things back (k_, with its
    //   save). Deleted once both received, or once closed with every giver's things back.
    // Spark has no server: the rules can't read a save, so a cheater can mark "gave" and keep the thing, or restore
    // their save after (docs/SECURITY.md). Tested by firebase/test/offers.test.mjs.
    match /offers/{id} {
      function sideOf(d) { return me() == d.a ? 'a' : 'b'; }
      function otherOf(d) { return me() == d.a ? 'b' : 'a'; }
      function party(d) { return d.a == me() || d.b == me(); }
      function savedNow() {
        return getAfter(/databases/$(database)/documents/saves/$(me())).data.t == request.time;
      }
      function friendsBoth(a, b) {
        return a in get(/databases/$(database)/documents/users/$(b)).data.get('friends', [])
          && b in get(/databases/$(database)/documents/users/$(a)).data.get('friends', []);
      }
      allow get: if signedIn() && (resource == null || party(resource.data));
      allow list: if signedIn() && party(resource.data);
      allow create: if signedIn() && validOffer(request.resource.data) && party(request.resource.data)
        && request.resource.data.a < request.resource.data.b
        && id == request.resource.data.a + '_' + request.resource.data.b
        && request.resource.data.v == 1 && request.resource.data.oa == 0 && request.resource.data.ob == 0
        && !request.resource.data.da && !request.resource.data.db && !request.resource.data.ra
        && !request.resource.data.rb && !request.resource.data.ka && !request.resource.data.kb
        && request.resource.data.ta == 0 && request.resource.data.tb == 0
        && request.resource.data.x == '' && request.resource.data.by == ''
        && request.resource.data['g' + otherOf(request.resource.data)].size() == 0
        && request.resource.data['n' + otherOf(request.resource.data)] == ''
        && friendsBoth(request.resource.data.a, request.resource.data.b)
        && !blocked(request.resource.data[otherOf(request.resource.data)], me());
      // one step of the list above: R before, N after, K the keys it changes, s my side, o the other
      function step(R, N, K, s, o) {
        return (K.hasOnly(['g' + s, 'n' + s, 'v', 't']) && R.x == '' && !R.da && !R.db && N.v == R.v + 1)
          || (K.hasOnly(['o' + s, 't']) && R.x == '' && !R.da && !R.db && N['o' + s] in [0, R.v])
          || (K.hasOnly(['d' + s, 't' + s, 't']) && R.x == '' && R.oa == R.v && R.ob == R.v && R.ga.size() > 0
            && R.gb.size() > 0 && !R['d' + s] && N['d' + s] == true && N['t' + s] == request.time && savedNow())
          || (K.hasOnly(['r' + s, 't']) && R.x == '' && R['d' + s] && R['d' + o] && !R['r' + s] && N['r' + s] == true
            && savedNow())
          || (K.hasOnly(['x', 'by', 't']) && R.x == '' && N.by == me() && (
            (N.x == 'cancel' && !R.da && !R.db)
            || (N.x == 'refused' && R['d' + o] && !R['r' + o] && !R['r' + s])
            || (N.x == 'stale' && R['d' + s] && !R['d' + o] && request.time > R['t' + s] + duration.value(7, 'd'))))
          || (K.hasOnly(['k' + s, 't']) && R.x in ['refused', 'stale'] && R['d' + s] && !R['k' + s]
            && N['k' + s] == true && savedNow());
      }
      allow update: if signedIn() && party(resource.data) && validOffer(request.resource.data)
        && step(resource.data, request.resource.data, request.resource.data.diff(resource.data).affectedKeys(),
          sideOf(resource.data), otherOf(resource.data));
      allow delete: if signedIn() && party(resource.data) && ((resource.data.ra && resource.data.rb)
        || resource.data.x == 'cancel'
        || (resource.data.x in ['refused', 'stale'] && (!resource.data.da || resource.data.ka)
          && (!resource.data.db || resource.data.kb)));
    }
    function offerThing(e) {
      return e is map && e.keys().hasOnly(['k', 'd']) && e.k in ['b', 'e', 'p'] && e.d is string && e.d.size() <= 16000;
    }
    function offerGive(g) {
      return g is list && g.size() <= 3 && (g.size() < 1 || offerThing(g[0])) && (g.size() < 2 || offerThing(g[1]))
        && (g.size() < 3 || offerThing(g[2]));
    }
    function validOffer(d) {
      return d.keys().hasOnly(['a', 'b', 'na', 'nb', 'ga', 'gb', 'oa', 'ob', 'da', 'db', 'ta', 'tb', 'ra', 'rb', 'ka',
          'kb', 'x', 'by', 't', 'v'])
        && d.size() == 20
        && shortText(d.a, 128) && shortText(d.b, 128) && shortText(d.na, 40) && shortText(d.nb, 40)
        && offerGive(d.ga) && offerGive(d.gb)
        && d.v is int && d.oa is int && d.ob is int
        && d.da is bool && d.db is bool && d.ra is bool && d.rb is bool && d.ka is bool && d.kb is bool
        && (d.ta == 0 || d.ta is timestamp) && (d.tb == 0 || d.tb is timestamp)
        && d.x in ['', 'cancel', 'refused', 'stale'] && shortText(d.by, 128)
        && d.t == request.time;
    }

    function validRequest(d) {
      return d.keys().hasOnly(['from', 'to', 'fromName', 'status', 't'])
        && d.from is string && d.to is string && shortText(d.fromName, 40) && d.t is number;
    }
  }
}
