{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "battleAnims.schema.json",
 "title": "game/data/battleAnims.json: how the battle plays a move, as data (VFX-8; logic/battle-anims.js, battle-anim-run.js)",
 "type": "object",
 "required": ["bigPower", "longPower", "extraMs", "shortSpeed", "maxMs", "flashes", "colors", "defaults", "intro", "families", "scenes", "sprites", "ramps", "iconSprites"],
 "additionalProperties": false,
 "properties": {
  "about": {"type": "string"},
  "bigPower": {"description": "a move of this power or more passes the power80 gate (a handheld wobble, the camera sweep)", "type": "number", "minimum": 0},
  "longPower": {"description": "a move of this power or more (and a signature scene) may run extraMs longer than its default family", "type": "number", "minimum": 0},
  "extraMs": {"description": "the most a long move or a scene may add (none under Reduced motion), stage ms", "type": "number", "minimum": 0, "maximum": 500},
  "shortSpeed": {"description": "at this battle speed or more a family's short variant plays", "type": "number", "exclusiveMinimum": 1},
  "maxMs": {
   "description": "the longest a move may play, stage ms, by outcome and category (the times before VFX-8); a long move or a scene adds at most extraMs",
   "type": "object",
   "required": ["H", "S", "X", "miss", "protect", "blocked"],
   "additionalProperties": false,
   "properties": {
    "H": {"type": "number", "minimum": 0}, "S": {"type": "number", "minimum": 0}, "X": {"type": "number", "minimum": 0},
    "miss": {"type": "number", "minimum": 0}, "protect": {"type": "number", "minimum": 0}, "blocked": {"type": "number", "minimum": 0}
   }
  },
  "flashes": {
   "description": "the full-screen flash limiter (WCAG 2.3.1): at most perSecond in any second, gapMs apart, none whose red share R/(R+G+B) is redShare or more; a flash held back becomes a sprite flash",
   "type": "object",
   "required": ["perSecond", "gapMs", "redShare"],
   "additionalProperties": false,
   "properties": {
    "perSecond": {"type": "integer", "minimum": 1, "maximum": 3},
    "gapMs": {"type": "number", "minimum": 333},
    "redShare": {"type": "number", "exclusiveMinimum": 0.33, "maximum": 1}
   }
  },
  "colors": {"description": "named colours steps use (or `type`: the move type's)", "type": "object", "additionalProperties": {"$ref": "#/$defs/hex"}},
  "defaults": {
   "description": "the family for each outcome and category when a move names none",
   "type": "object",
   "required": ["H", "S", "X", "miss", "protect", "blocked"],
   "additionalProperties": false,
   "properties": {
    "H": {"$ref": "#/$defs/id"}, "S": {"$ref": "#/$defs/id"}, "X": {"$ref": "#/$defs/id"},
    "miss": {"$ref": "#/$defs/id"}, "protect": {"$ref": "#/$defs/id"}, "blocked": {"$ref": "#/$defs/id"}
   }
  },
  "intro": {"description": "steps every move plays first", "type": "array", "items": {"$ref": "#/$defs/step"}},
  "families": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/family"}},
  "scenes": {"description": "signature scenes by id (VFX-17); a family's shape", "type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/family"}},
  "moods": {"description": "VFX-15: the battle mood over the place mood (logic/battle-stage-look.js battleMoodFor; the grade pass): a darken and a type tint on big moves and super-effective hits, the row wave, heat", "type": "object", "required": ["dark", "tint", "inMs", "outMs", "superEffective", "bureau", "wave", "heat"], "additionalProperties": false, "properties": {
   "about": {"type": "string"},
   "dark": {"description": "how much darker, at most .2 (the owner's pick)", "type": "number", "minimum": 0, "maximum": 0.2},
   "tint": {"type": "number", "minimum": 0, "maximum": 1},
   "inMs": {"type": "number", "minimum": 0},
   "outMs": {"type": "number", "minimum": 0},
   "superEffective": {"type": "boolean"},
   "bureau": {"$ref": "#/$defs/hex"},
   "wave": {"type": "object", "required": ["types", "bureau", "px", "bigPx", "rowPx", "speed"], "additionalProperties": false, "properties": {"types": {"type": "array", "items": {"type": "string"}}, "bureau": {"type": "boolean"}, "px": {"type": "integer", "minimum": 0, "maximum": 8}, "bigPx": {"type": "integer", "minimum": 0, "maximum": 8}, "rowPx": {"type": "integer", "minimum": 1, "maximum": 32}, "speed": {"type": "number", "minimum": 0}}},
   "heat": {"type": "object", "required": ["types", "amount"], "additionalProperties": false, "properties": {"types": {"type": "array", "items": {"type": "string"}}, "amount": {"type": "number", "minimum": 0, "maximum": 1.5}}}
  }},
  "weather": {"description": "VFX-15: the walk weather on the battle stage (walk/fountains-weather.js drawWeather)", "type": "object", "required": ["rain", "settle", "sunny", "sand"], "additionalProperties": false, "properties": {
   "about": {"type": "string"},
   "rain": {"type": "object", "required": ["splash", "r"], "additionalProperties": false, "properties": {"splash": {"type": "number", "minimum": 0}, "r": {"type": "number", "minimum": 0}}},
   "settle": {"type": "object", "required": ["ms", "cap", "r"], "additionalProperties": false, "properties": {"ms": {"type": "number", "minimum": 0}, "cap": {"type": "integer", "minimum": 0, "maximum": 200}, "r": {"type": "number", "minimum": 0}}},
   "sunny": {"type": "object", "required": ["warm", "rays"], "additionalProperties": false, "properties": {"warm": {"type": "number", "minimum": 0, "maximum": 1}, "rays": {"type": "number", "minimum": 0, "maximum": 3}}},
   "sand": {"type": "object", "required": ["n", "gust", "gustMs", "colors"], "additionalProperties": false, "properties": {"n": {"type": "integer", "minimum": 0, "maximum": 400}, "gust": {"type": "number", "minimum": 1}, "gustMs": {"type": "number", "minimum": 0}, "colors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}}}}
  }},
  "scars": {"description": "VFX-15: battle scars (walk/battle-scars.js; logic/battle-stage-look.js scarKindFor, scarCap, scarAdd)", "type": "object", "required": ["cap", "maxM", "fadeMs", "fadeSteps", "heavy", "kinds"], "additionalProperties": false, "properties": {
   "about": {"type": "string"},
   "cap": {"description": "at most this many by the battle's quality 0-3", "type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 12}},
   "maxM": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.2},
   "fadeMs": {"type": "number", "minimum": 0},
   "fadeSteps": {"type": "integer", "minimum": 1, "maximum": 8},
   "heavy": {"type": "number", "minimum": 0, "maximum": 1},
   "kinds": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "object", "required": ["m", "sprite", "color"], "additionalProperties": false, "properties": {"types": {"type": "array", "items": {"type": "string"}}, "sandstorm": {"type": "boolean"}, "heavy": {"type": "boolean"}, "m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.2}, "sprite": {"$ref": "#/$defs/id"}, "ramp": {"type": "string"}, "color": {"$ref": "#/$defs/hex"}}}}
  }}
,
  "artAbout": {"type": "string"},
  "sprites": {
   "description": "VFX-10: the effect strips by id: game/art/battle/anims/<id>.png, frames side by side in 8 greys (tools/build-battle-anims.py --check holds the strips to this)",
   "type": "object",
   "propertyNames": {"$ref": "#/$defs/id"},
   "additionalProperties": {
    "type": "object",
    "required": ["cell", "frames", "anchor"],
    "additionalProperties": false,
    "properties": {
     "about": {"type": "string"},
     "cell": {"description": "one frame's width and height, px", "type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 64}, "minItems": 2, "maxItems": 2},
     "frames": {"description": "frames in the strip (3-8 for an effect; a mark on the ground may have 1)", "type": "integer", "minimum": 1, "maximum": 8},
     "anchor": {"description": "the px, from the top left, that sits on the effect's place", "type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
     "fps": {"description": "frames a second (12 when left out)", "type": "number", "minimum": 1, "maximum": 30},
     "impact": {"description": "its first two frames play at 24 fps", "type": "boolean"},
     "loop": {"description": "plays round while it lives (else once, ending with its life)", "type": "boolean"},
     "ground": {"description": "a mark on the ground at 32 px/m (VFX-15's scars); else a texel is a stage pixel at its depth", "type": "boolean"}
    }
   }
  },
  "ramps": {
   "description": "VFX-10: what colours a sprite, by id (a type id, None, Bureau, up, down, heal): grey index i is the ramp's step i (0-6), 7 stays white",
   "type": "object",
   "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
   "additionalProperties": {
    "type": "object",
    "required": ["ramp", "light"],
    "additionalProperties": false,
    "properties": {
     "about": {"type": "string"},
     "ramp": {
      "description": "an NW_PALETTE ramp (game/art/next/palette.js) or 8 hexes, darkest first",
      "oneOf": [
       {"type": "string", "enum": ["skin", "skin_deep", "ember", "crimson", "gold", "straw", "olive", "leaf", "pine", "mint", "teal", "sky", "cobalt", "indigo", "violet", "orchid", "rose", "rust", "steel", "stone"]},
       {"type": "array", "items": {"$ref": "#/$defs/hex"}, "minItems": 8, "maxItems": 8}
      ]
     },
     "light": {"description": "the colour it lights the stage with: a hex, or type (the type's glow, types.json)", "oneOf": [{"const": "type"}, {"$ref": "#/$defs/hex"}]}
    }
   }
  },
  "events": {
   "description": "the battle's flow moments and the stage effects of statuses and stats, by event: each step adds its own keys (VFX-16: vs, sendOut, recall, catch, faint, levelUp, victory, defeat, item; VFX-14: its own)",
   "type": "object",
   "properties": {
    "about": {"type": "string"},
    "vs": {"type": "object", "required": ["foes", "rivals", "scale", "hold"], "additionalProperties": false, "properties": {"foes": {"type": "array", "items": {"enum": ["miniboss", "boss", "rival"]}}, "rivals": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "scale": {"type": "integer", "minimum": 1, "maximum": 4}, "hold": {"type": "number", "minimum": 0, "maximum": 700}}},
    "sendOut": {"type": "object", "required": ["riseMs", "burst", "kinds", "glint"], "additionalProperties": false, "properties": {"riseMs": {"type": "number", "minimum": 0}, "burst": {"type": "integer", "minimum": 0}, "kinds": {"type": "object", "additionalProperties": {"type": "string"}}, "glint": {"type": "object", "required": ["coat", "prime", "n"], "additionalProperties": false, "properties": {"coat": {"type": "string"}, "prime": {"type": "string"}, "n": {"type": "integer", "minimum": 0}}}}},
    "recall": {"type": "object", "required": ["w", "outMs"], "additionalProperties": false, "properties": {"w": {"type": "number", "minimum": 0}, "outMs": {"type": "number", "minimum": 0}}},
    "catch": {"type": "object", "required": ["squash", "dust", "ringR", "shards"], "additionalProperties": false, "properties": {"squash": {"type": "number", "minimum": 0, "maximum": 0.5}, "dust": {"type": "integer", "minimum": 0}, "ringR": {"type": "number", "minimum": 0}, "shards": {"type": "integer", "minimum": 0}}},
    "faint": {"type": "object", "required": ["holdMs", "outMs", "dust", "bolts", "smoke"], "additionalProperties": false, "properties": {"holdMs": {"type": "number", "minimum": 0}, "outMs": {"type": "number", "minimum": 0}, "dust": {"type": "integer", "minimum": 0}, "bolts": {"type": "integer", "minimum": 0}, "smoke": {"type": "integer", "minimum": 0}}},
    "levelUp": {"type": "object", "required": ["ramp", "n", "h", "ringR"], "additionalProperties": false, "properties": {"ramp": {"type": "string"}, "n": {"type": "integer", "minimum": 0}, "h": {"type": "number", "minimum": 0}, "ringR": {"type": "number", "minimum": 0}}},
    "victory": {"type": "object", "required": ["sparkles", "cheerMs"], "additionalProperties": false, "properties": {"sparkles": {"type": "integer", "minimum": 0}, "cheerMs": {"type": "number", "minimum": 0}}},
    "defeat": {"type": "object", "required": ["fadeMs"], "additionalProperties": false, "properties": {"fadeMs": {"type": "number", "minimum": 0}}},
    "item": {"type": "object", "required": ["flyMs"], "additionalProperties": false, "properties": {"flyMs": {"type": "number", "minimum": 0}}}
   }
  },
  "iconSprites": {
   "description": "VFX-10: the icons.png particles the stage draws with a strip instead, like for like (sprite), and the ramp an untyped one takes",
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["sprite", "ramp"],
    "additionalProperties": false,
    "properties": {"sprite": {"$ref": "#/$defs/id"}, "ramp": {"type": "string"}}
   }
  }
 },
 "$defs": {
  "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
  "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
  "timeline": {
   "type": "object",
   "required": ["dur", "hit", "steps"],
   "properties": {
    "dur": {"description": "stage ms until the line may move on", "type": "number", "minimum": 0},
    "hit": {"description": "stage ms when the plates repaint (999: no hit)", "type": "number", "minimum": 0},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}
   }
  },
  "family": {
   "allOf": [{"$ref": "#/$defs/timeline"}],
   "type": "object",
   "properties": {
    "about": {"type": "string"},
    "dur": true, "hit": true, "steps": true,
    "short": {"description": "the Faster variant", "$ref": "#/$defs/timeline"}
   },
   "additionalProperties": false
  },
  "step": {
   "type": "object",
   "required": ["do"],
   "properties": {
    "do": {"enum": ["focus", "camAt", "camTo", "camHome", "toTarget", "handheld", "action", "lunge", "dust", "ring", "groundRing", "beam", "lob", "fling", "converge", "blink", "dodge", "pop", "hit"]},
    "at": {"description": "stage ms after the move starts (missing: at once)", "type": "number", "minimum": 0},
    "n": {"description": "repeats (every ms apart)", "type": "integer", "minimum": 1},
    "every": {"type": "number", "minimum": 0},
    "if": {"type": "array", "items": {"enum": ["H", "S", "X", "self", "protect", "dmg", "landed", "power80", "gl", "motion", "!H", "!S", "!X", "!self", "!protect", "!dmg", "!landed", "!power80", "!gl", "!motion"]}},
    "types": {"type": "array", "items": {"type": "string"}},
    "on": {"enum": ["attacker", "target", "subject", "wide"]},
    "color": {"type": "string"},
    "pop": {"enum": ["miss", "hedged"]},
    "pose": {"type": "string"},
    "ease": {"type": "string"},
    "cam": {"type": "object", "additionalProperties": {"type": "number"}}
   },
   "additionalProperties": {"type": "number"}
  }
 }
}
