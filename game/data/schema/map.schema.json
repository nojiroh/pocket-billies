{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "map.schema.json",
 "title": "game/data/maps/<id>.json: a walkable map (a town, a route, a room or a test scene)",
 "type": "object",
 "required": ["name", "w", "h", "edge", "kind", "hub", "exits", "tiles", "props"],
 "properties": {
  "name": {"type": "string", "minLength": 1},
  "w": {"description": "width in metres", "type": "integer", "minimum": 4, "maximum": 400},
  "h": {"description": "depth in metres", "type": "integer", "minimum": 4, "maximum": 400},
  "edge": {"description": "the ground kind (a key of scenery.terrains) round the map", "type": "string", "minLength": 1, "maxLength": 1},
  "kind": {"enum": ["town", "route", "room", "test"]},
  "locationId": {"type": ["string", "null"]},
  "hub": {"$ref": "#/$defs/point"},
  "exits": {"type": "array", "items": {"$ref": "#/$defs/point"}},
  "edgeExits": {
   "type": "array",
   "items": {"type": "object", "required": ["side", "t"], "properties": {"id": {"type": "string"}, "side": {"enum": ["N", "S", "E", "W"]}, "t": {"type": "number"}, "in": {"type": "number"}, "width": {"type": "number"}}}
  },
  "tiles": {"description": "the ground, a row of ground-kind keys per metre (h rows of w)", "type": "array", "items": {"type": "string"}},
  "heights": {"description": "the land's height at each metre corner ((h+1) rows of w+1)", "type": "array", "items": {"type": "array", "items": {"type": "number"}}},
  "steps": {"description": "the step grid (raised cells), base64", "type": "string"},
  "stepm": {"description": "the step grid's material, base64", "type": "string"},
  "people": {"description": "people who only talk (Project Story: their script; when / unless: there only while the story allows)", "type": "array", "items": {"type": "object", "required": ["id", "who"], "properties": {"id": {"type": "string"}, "who": {"type": "string"}, "script": {"type": "array", "items": {"type": "string"}}, "when": {"type": "string"}, "unless": {"type": "string"}}}},
  "props": {
   "type": "array",
   "items": {"type": "object", "required": ["k", "x", "z"], "properties": {"k": {"type": "string", "minLength": 1}, "x": {"type": "number"}, "z": {"type": "number"}, "s": {"type": "number"}, "rot": {"description": "degrees it is turned about its base point (the middle of its front): positive turns its right-hand end away from you; -180 to 180", "type": "number", "minimum": -180, "maximum": 180}}}
  },
  "chat": {"type": "array", "items": {"type": "string"}},
  "cam": {
   "description": "the walking camera: tilt (degrees), height (m), field of view; island track: orbit",
   "type": "object",
   "properties": {
    "pitch": {"type": "number"},
    "h": {"type": "number"},
    "fov": {"type": "number"},
    "orbit": {
     "description": "island track: the camera sits out over the sea and looks in at c; inside dead metres of c the yaw holds; lag: seconds the yaw takes to follow; turn: degrees the player may still turn it",
     "type": "object",
     "required": ["c", "dead", "lag", "turn"],
     "properties": {"c": {"$ref": "#/$defs/point"}, "dead": {"type": "number", "minimum": 0}, "lag": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}, "turn": {"type": "number", "minimum": 0, "maximum": 180}}
    }
   }
  },
  "island": {
   "description": "island track: the island's middle and its coastline, a closed polygon (the last point joins the first)",
   "type": "object",
   "required": ["c", "coast"],
   "properties": {"c": {"$ref": "#/$defs/point"}, "coast": {"$ref": "#/$defs/poly"}}
  },
  "zones": {
   "description": "island track: areas of the island; a locked zone's ground and props are never touched when the island is made again",
   "type": "array",
   "items": {"type": "object", "required": ["k", "poly"], "properties": {"k": {"enum": ["town", "barn", "pasture", "forest", "mountain", "cove", "beach", "path"]}, "poly": {"$ref": "#/$defs/poly"}, "lock": {"type": "boolean"}}}
  },
  "islandGen": {
   "description": "island track: the island generator's version, seed and dials (IS-2 owns the dials), so the ground can be made again",
   "type": "object",
   "required": ["v", "seed"],
   "properties": {"v": {"type": "integer", "minimum": 0}, "seed": {"type": "string"}, "dials": {"type": "object"}}
  },
  "waterKind": {"description": "the kind of the map's water (walk/water-data.js WATER_KIND_LOOKS)", "enum": ["pond", "stream", "canal", "spring", "swamp", "lake", "sea", "lava", "ice"]},
  "test": {"type": ["boolean", "number"]}
 },
 "$defs": {
  "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2},
  "poly": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3}
 }
}
