{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "map.schema.json",
 "title": "game/data/maps/<id>.json: a walkable map (a town, a route, a room or a test scene)",
 "type": "object",
 "required": ["name", "w", "h", "edge", "kind", "hub", "exits", "tiles", "props"],
 "properties": {
  "name": {"type": "string", "minLength": 1},
  "w": {"description": "width in metres", "type": "integer", "minimum": 4, "maximum": 400},
  "h": {"description": "depth in metres", "type": "integer", "minimum": 4, "maximum": 400},
  "edge": {"description": "the ground kind (a key of scenery.terrains) round the map", "type": "string", "minLength": 1, "maxLength": 1},
  "kind": {"enum": ["town", "route", "room", "test"]},
  "locationId": {"type": ["string", "null"]},
  "hub": {"$ref": "#/$defs/point"},
  "exits": {"type": "array", "items": {"$ref": "#/$defs/point"}},
  "edgeExits": {
   "type": "array",
   "items": {"type": "object", "required": ["side", "t"], "properties": {"id": {"type": "string"}, "side": {"enum": ["N", "S", "E", "W"]}, "t": {"type": "number"}, "in": {"type": "number"}, "width": {"type": "number"}}}
  },
  "tiles": {"description": "the ground, a row of ground-kind keys per metre (h rows of w)", "type": "array", "items": {"type": "string"}},
  "heights": {"description": "the land's height at each metre corner ((h+1) rows of w+1)", "type": "array", "items": {"type": "array", "items": {"type": "number"}}},
  "steps": {"description": "the step grid (raised cells), base64", "type": "string"},
  "stepm": {"description": "the step grid's material, base64", "type": "string"},
  "people": {"description": "people who only talk (Project Story: their script; when / unless: there only while the story allows)", "type": "array", "items": {"type": "object", "required": ["id", "who"], "properties": {"id": {"type": "string"}, "who": {"type": "string"}, "script": {"type": "array", "items": {"type": "string"}}, "when": {"type": "string"}, "unless": {"type": "string"}}}},
  "props": {
   "type": "array",
   "items": {"type": "object", "required": ["k", "x", "z"], "properties": {"k": {"type": "string", "minLength": 1}, "x": {"type": "number"}, "z": {"type": "number"}, "s": {"type": "number"}}}
  },
  "chat": {"type": "array", "items": {"type": "string"}},
  "test": {"type": ["boolean", "number"]}
 },
 "$defs": {"point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2}}
}
