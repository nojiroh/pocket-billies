{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "robots.schema.json",
 "title": "game/data/robots.json: robot parts and gems (phase 17)",
 "type": "object",
 "required": ["parts", "gems"],
 "additionalProperties": false,
 "properties": {
  "_help": {"type": "string"},
  "parts": {
   "type": "object",
   "propertyNames": {"pattern": "^[a-z0-9_]+$"},
   "additionalProperties": {
    "type": "object",
    "required": ["name", "slot", "type", "wt", "stats", "art"],
    "additionalProperties": false,
    "properties": {
     "name": {"type": "string", "minLength": 1},
     "short": {"description": "a torso's family name, used in a robot's default name", "type": "string"},
     "slot": {"enum": ["torso", "arm", "legs"]},
     "type": {"description": "a type id; a torso's and legs' types are the robot's", "type": "string"},
     "rar": {"description": "UI-14b: its tier on the loot ladder (an arm's or legs' as an Augment: frame, pill and name colour), or boss (a boss's own part, never offered)", "enum": ["common", "uncommon", "rare", "mythical", "boss"]},
     "wt": {"description": "kg", "type": "number", "minimum": 0},
     "dur": {"description": "how tough the part is: its HP x this", "type": "number", "exclusiveMinimum": 0},
     "carry": {"description": "legs: kg they carry before the robot slows down", "type": "number", "exclusiveMinimum": 0},
     "move": {"description": "the move it gives (arms and legs)", "type": "string"},
     "stats": {"$ref": "#/$defs/stats"},
     "art": {"$ref": "#/$defs/art"},
     "d": {"type": "string"}
    }
   }
  },
  "gems": {
   "type": "object",
   "propertyNames": {"pattern": "^[a-z0-9_]+$"},
   "additionalProperties": {
    "type": "object",
    "required": ["name", "type", "move", "stats", "color"],
    "additionalProperties": false,
    "properties": {
     "name": {"type": "string", "minLength": 1},
     "short": {"type": "string"},
     "type": {"type": "string"},
     "rar": {"description": "UI-14b: its tier on the loot ladder", "enum": ["common", "uncommon", "rare", "mythical"]},
     "move": {"description": "its signature move", "type": "string"},
     "stats": {"$ref": "#/$defs/stats"},
     "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
     "img": {"description": "its picture on the torso's chest, a path in game/art", "type": "string"},
     "d": {"type": "string"}
    }
   }
  }
 },
 "$defs": {
  "stats": {
   "description": "added to the robot's stats, by stat id (stats.json)",
   "type": "object",
   "additionalProperties": {"type": "number"}
  },
  "art": {
   "description": "the placeholder picture",
   "type": "object",
   "required": ["color", "shape"],
   "additionalProperties": false,
   "properties": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "shape": {"enum": ["block", "barrel", "slim", "fist", "drill", "claw", "cannon", "coil", "treads", "legs", "hover"]},
    "w": {"type": "integer", "minimum": 4, "maximum": 48},
    "h": {"type": "integer", "minimum": 4, "maximum": 48},
    "img": {"description": "the front picture, a path in game/art", "type": "string"},
    "imgB": {"description": "the back picture", "type": "string"},
    "head": {"description": "a torso's head, front", "type": "string"},
    "headB": {"description": "a torso's head, back", "type": "string"},
    "joints": {"$ref": "#/$defs/joints", "description": "studio track ST-5: where its picture joins, per view; what is not here is worked out from the picture's size"},
    "headJoints": {"$ref": "#/$defs/joints", "description": "a torso's head: where its picture joins the neck, per view"},
    "turn": {"$ref": "#/$defs/turn"},
    "headTurn": {"$ref": "#/$defs/turn"}
   }
  },
  "joints": {
   "type": "object",
   "additionalProperties": false,
   "properties": {"front": {"$ref": "#/$defs/joint"}, "back": {"$ref": "#/$defs/joint"}}
  },
  "joint": {
   "description": "points are fractions of the picture, x right and y down",
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "pivot": {"description": "the point it hangs from (its socket's point on the part it joins) and turns around", "$ref": "#/$defs/point"},
    "sockets": {
     "description": "a torso's sockets: neck, shoulderL, shoulderR, hipL, hipR, hip (treads and hover), gem",
     "type": "object",
     "propertyNames": {"enum": ["neck", "shoulderL", "shoulderR", "hipL", "hipR", "hip", "gem"]},
     "additionalProperties": {"$ref": "#/$defs/point"}
    },
    "z": {"description": "draw order in this view: higher is drawn in front", "type": "number"}
   }
  },
  "point": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 2}, "minItems": 2, "maxItems": 2},
  "turn": {"description": "how far it may turn, [least, most] degrees (the workbench's test fit)", "type": "array", "items": {"type": "number", "minimum": -180, "maximum": 180}, "minItems": 2, "maxItems": 2}
 }
}
