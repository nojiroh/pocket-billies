{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "setPieces.schema.json",
 "title": "game/data/setPieces.json: set pieces, small groups of existing props placed as a unit on a laid-out place (routes track RT-3; logic/mapgen.js mapgenStagePieces)",
 "type": "object",
 "required": [
  "perPlace",
  "pieces"
 ],
 "additionalProperties": false,
 "properties": {
  "about": {
   "type": "string"
  },
  "perPlace": {
   "description": "how many a laid-out place gets: at least, at most",
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 8
   },
   "minItems": 2,
   "maxItems": 2
  },
  "pieces": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "on",
     "r",
     "biomes",
     "props"
    ],
    "properties": {
     "name": {
      "description": "what it is called (the Studio, the debug log)",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "on": {
      "description": "the spot kinds it may take",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "enum": [
        "roadside",
        "clearing",
        "jetty"
       ]
      }
     },
     "r": {
      "description": "every prop lies within this many metres of the piece's origin (the middle of its front)",
      "type": "number",
      "minimum": 1,
      "maximum": 8
     },
     "biomes": {
      "description": "draw weights by biomes.json biome, default for one not listed (0: never)",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
       "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      }
     },
     "plans": {
      "description": "a layout plan's multiplier on the weight (logic/mapgen.js MAPGEN_LAYOUTS)",
      "type": "object",
      "propertyNames": {
       "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
       "type": "number",
       "minimum": 0,
       "maximum": 10
      }
     },
     "props": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "k",
        "x",
        "z"
       ],
       "properties": {
        "k": {
         "description": "a scenery.json prop",
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "x": {
         "type": "number",
         "minimum": -12,
         "maximum": 12,
         "description": "metres across the piece's front (right positive)"
        },
        "z": {
         "type": "number",
         "minimum": -12,
         "maximum": 12,
         "description": "metres back from the piece's front, away from the road"
        },
        "rot": {
         "description": "degrees on top of the piece's turn (models only)",
         "type": "number",
         "minimum": -180,
         "maximum": 180
        },
        "say": {
         "description": "a sign's words, read when tapped",
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        },
        "water": {
         "description": "it stands on water (a boat)",
         "type": "boolean"
        }
       }
      }
     },
     "people": {
      "type": "array",
      "maxItems": 2,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "who",
        "x",
        "z"
       ],
       "properties": {
        "who": {
         "description": "a person's sprite (the people sprites, as events.json classes' who)",
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "x": {
         "type": "number",
         "minimum": -12,
         "maximum": 12
        },
        "z": {
         "type": "number",
         "minimum": -12,
         "maximum": 12
        },
        "event": {
         "description": "an events.json event the person opens once a run",
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "say": {
         "description": "what they say once it is played (or always, with no event)",
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        }
       }
      }
     }
    }
   }
  }
 }
}
