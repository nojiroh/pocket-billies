{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "genes.schema.json",
 "title": "game/data/genes.json: Genes, the parts a Billie can be spliced with: traits per part kind, dominant types, Stability (splicing track SP-2; logic/genes.js)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kinds",
  "traits",
  "parts",
  "maxTraits",
  "stability",
  "unstable"
 ],
 "properties": {
  "about": {
   "type": "string"
  },
  "kinds": {
   "description": "a part kind (partKits.json parts.kind) and the trait it brings",
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "trait"
    ],
    "properties": {
     "trait": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "a key of traits"
     }
    }
   }
  },
  "traits": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "d",
     "fx"
    ],
    "properties": {
     "name": {
      "description": "what the player reads",
      "type": "string",
      "minLength": 1,
      "maxLength": 24
     },
     "d": {
      "description": "what it does, in one sentence",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "fx": {
      "description": "its effects on the Billie that wears it (logic/effects.js fxOfBillie)",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
       "oneOf": [
        {
         "description": "money: what a won battle pays ($), times mult",
         "type": "object",
         "additionalProperties": false,
         "required": [
          "kind",
          "mult"
         ],
         "properties": {
          "kind": {
           "const": "money"
          },
          "mult": {
           "type": "number",
           "minimum": 0,
           "maximum": 4
          }
         }
        },
        {
         "description": "stat: your Billies on the field when a battle starts get stages of a stat (stats.json; not HP)",
         "type": "object",
         "additionalProperties": false,
         "required": [
          "kind",
          "stat",
          "stages"
         ],
         "properties": {
          "kind": {
           "const": "stat"
          },
          "stat": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]*$",
           "description": "a stat of stats.json other than hp (check-data and the Studio check it against the data)"
          },
          "stages": {
           "type": "integer",
           "minimum": -6,
           "maximum": 6
          }
         }
        },
        {
         "description": "damage: what your Billies deal (deal) or take (take), times mult; only moves of a category (H physical, S special) or a type when given",
         "type": "object",
         "additionalProperties": false,
         "required": [
          "kind",
          "side",
          "mult"
         ],
         "properties": {
          "kind": {
           "const": "damage"
          },
          "side": {
           "enum": [
            "deal",
            "take"
           ]
          },
          "cat": {
           "enum": [
            "H",
            "S"
           ]
          },
          "type": {
           "type": "string",
           "minLength": 1
          },
          "mult": {
           "type": "number",
           "minimum": 0,
           "maximum": 4
          }
         }
        },
        {
         "description": "turnHurt (an Unstable splice's drawback): the Billie loses this share of its HP at each turn's end",
         "type": "object",
         "additionalProperties": false,
         "required": [
          "kind",
          "share"
         ],
         "properties": {
          "kind": {
           "const": "turnHurt"
          },
          "share": {
           "type": "number",
           "exclusiveMinimum": 0,
           "maximum": 0.5
          }
         }
        }
       ]
      }
     }
    }
   }
  },
  "parts": {
   "description": "per part (partKits.json parts): its dominant type (it becomes the Billie's second type) and the move it teaches (SP-4)",
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "minProperties": 1,
    "properties": {
     "type": {
      "type": "string",
      "minLength": 1,
      "description": "a type of types.json"
     },
     "move": {
      "type": "string",
      "minLength": 1,
      "description": "a move of moves.json"
     }
    }
   }
  },
  "maxTraits": {
   "description": "the most traits a Billie shows and has",
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "stability": {
   "description": "what a foreign part costs: from the Billie's own line, from another species whose part is of the same kit, from another kit, an Augment; the limit before a splice is Unstable, and how far past the limit a splice is refused",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "line",
    "kit",
    "other",
    "augment",
    "limit",
    "refuse"
   ],
   "properties": {
    "line": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    },
    "kit": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    },
    "other": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    },
    "augment": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    },
    "limit": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    },
    "refuse": {
     "type": "integer",
     "minimum": 0,
     "maximum": 20
    }
   }
  },
  "unstable": {
   "description": "a splice past the Stability limit: one stat times up, another times down (picked from the Billie and its splice, never rolled again), and the drawback's rows",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "up",
    "down",
    "name",
    "d",
    "fx"
   ],
   "properties": {
    "up": {
     "type": "number",
     "minimum": 1,
     "maximum": 2
    },
    "down": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 1
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 24
    },
    "d": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120
    },
    "fx": {
     "description": "its effects on the Billie that wears it (logic/effects.js fxOfBillie)",
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "oneOf": [
       {
        "description": "money: what a won battle pays ($), times mult",
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "mult"
        ],
        "properties": {
         "kind": {
          "const": "money"
         },
         "mult": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
         }
        }
       },
       {
        "description": "stat: your Billies on the field when a battle starts get stages of a stat (stats.json; not HP)",
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "stat",
         "stages"
        ],
        "properties": {
         "kind": {
          "const": "stat"
         },
         "stat": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "a stat of stats.json other than hp (check-data and the Studio check it against the data)"
         },
         "stages": {
          "type": "integer",
          "minimum": -6,
          "maximum": 6
         }
        }
       },
       {
        "description": "damage: what your Billies deal (deal) or take (take), times mult; only moves of a category (H physical, S special) or a type when given",
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "side",
         "mult"
        ],
        "properties": {
         "kind": {
          "const": "damage"
         },
         "side": {
          "enum": [
           "deal",
           "take"
          ]
         },
         "cat": {
          "enum": [
           "H",
           "S"
          ]
         },
         "type": {
          "type": "string",
          "minLength": 1
         },
         "mult": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
         }
        }
       },
       {
        "description": "turnHurt (an Unstable splice's drawback): the Billie loses this share of its HP at each turn's end",
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "share"
        ],
        "properties": {
         "kind": {
          "const": "turnHurt"
         },
         "share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
         }
        }
       }
      ]
     }
    }
   }
  }
 }
}
