{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "story.schema.json",
 "title": "game/data/story.json: the story layer's flags, speakers, quests and start presets (Project Story)",
 "type": "object",
 "required": ["flags", "patterns", "kept", "speakers", "quests", "presets"],
 "additionalProperties": false,
 "properties": {
  "about": {"type": "string"},
  "flags": {"description": "every story flag the game sets or reads, and what it means", "type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
  "patterns": {"description": "flags made from an id: met_<id>", "type": "object", "propertyNames": {"pattern": "^[A-Za-z]+_<[a-z]+>$"}, "additionalProperties": {"type": "string", "minLength": 1}},
  "kept": {"description": "the story's own records in saveData.story that aren't flags", "type": "object", "additionalProperties": {"type": "string"}},
  "speakers": {"description": "a name a script writes before a line -> a person id (or me)", "type": "object", "propertyNames": {"pattern": "^[A-Za-z][\\w-]*$"}, "additionalProperties": {"type": "string"}},
  "scripts": {"description": "scripts that belong to the story, not to a person or a trainer: story:<id> (docs/SCRIPTS.md)", "type": "object", "additionalProperties": {"type": "object", "required": ["who", "script"], "additionalProperties": false, "properties": {"about": {"type": "string"}, "who": {"description": "who says a line that names nobody (a person id)", "type": "string"}, "script": {"type": "array", "items": {"type": "string"}}}}},
  "quests": {"description": "each quest's stages, in order", "type": "object", "additionalProperties": {"type": "object", "required": ["stages"], "properties": {"about": {"type": "string"}, "stages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[\\w-]+$"}}}}},
  "presets": {
   "description": "start points for ?story=<preset>, test runs only",
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["about", "place", "team"],
    "additionalProperties": false,
    "properties": {
     "about": {"type": "string"},
     "place": {"description": "a location id", "type": "string"},
     "flags": {"type": "object"},
     "beaten": {"description": "trainer ids; a leader's badge comes with them", "type": "array", "items": {"type": "string"}},
     "coins": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
     "items": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
     "team": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "object", "required": ["sp", "lvl"], "additionalProperties": false, "properties": {"sp": {"type": "string"}, "lvl": {"type": "integer", "minimum": 1, "maximum": 100}}}}
    }
   }
  }
 }
}
