{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "trainer.schema.json",
 "title": "game/data/trainers/<id>.json: a trainer you can battle",
 "type": "object",
 "required": ["name", "who", "node", "team", "reward", "lines", "win", "lose"],
 "properties": {
  "name": {"type": "string", "minLength": 1},
  "who": {"description": "their look (a person id)", "type": "string"},
  "battleStage": {"type": "string"},
  "node": {"description": "the route stop where they wait", "type": "integer", "minimum": 0},
  "blocks": {"type": "boolean"},
  "team": {
   "type": "array",
   "minItems": 1,
   "items": {"type": "object", "required": ["sp", "lvl"], "properties": {"sp": {"description": "a species id, or @rival", "type": "string"}, "lvl": {"type": "integer", "minimum": 1, "maximum": 100}}}
  },
  "reward": {"type": "number", "minimum": 0},
  "lines": {"type": "array", "items": {"type": "string"}},
  "win": {"type": "string"},
  "lose": {"type": "string"},
  "double": {"type": "boolean"}
 }
}
