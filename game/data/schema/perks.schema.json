{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "perks.schema.json",
 "title": "game/data/perks.json: a run's Perks (relics), each a list of effect rows (roguelite track RL-12; logic/effects.js)",
 "type": "object",
 "propertyNames": {
  "pattern": "^[a-z][a-z0-9_]*$"
 },
 "minProperties": 1,
 "additionalProperties": {
  "type": "object",
  "required": ["name", "d", "rarity", "fx"],
  "additionalProperties": false,
  "properties": {
   "name": {"description": "what the player reads", "type": "string", "minLength": 1, "maxLength": 40},
   "d": {"description": "what it does, in one sentence", "type": "string", "minLength": 1, "maxLength": 160},
   "rarity": {"description": "how often it is offered (rules.json run.perks.rarity) and what a shop asks (run.perks.price)", "enum": ["common", "uncommon", "rare"]},
   "fx": {
    "description": "its effects (logic/effects.js FX_KINDS)",
    "type": "array",
    "minItems": 1,
    "maxItems": 4,
    "items": {
     "oneOf": [
      {
       "description": "money: what a won battle pays ($), times mult",
       "type": "object", "additionalProperties": false, "required": ["kind", "mult"],
       "properties": {"kind": {"const": "money"}, "mult": {"type": "number", "minimum": 0, "maximum": 4}}
      },
      {
       "description": "price: a run shop's prices (shop) or a run town's clinic (heal), times mult",
       "type": "object", "additionalProperties": false, "required": ["kind", "what", "mult"],
       "properties": {"kind": {"const": "price"}, "what": {"enum": ["shop", "heal"]}, "mult": {"type": "number", "minimum": 0, "maximum": 4}}
      },
      {
       "description": "catch: a coin's chance to catch, times mult (never past 1)",
       "type": "object", "additionalProperties": false, "required": ["kind", "mult"],
       "properties": {"kind": {"const": "catch"}, "mult": {"type": "number", "minimum": 0, "maximum": 4}}
      },
      {
       "description": "stat: your Billies on the field when a battle starts get stages of a stat (stats.json; not HP)",
       "type": "object", "additionalProperties": false, "required": ["kind", "stat", "stages"],
       "properties": {"kind": {"const": "stat"}, "stat": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "a stat of stats.json other than hp (check-data and the Studio check it against the data)"}, "stages": {"type": "integer", "minimum": -6, "maximum": 6}}
      },
      {
       "description": "damage: what your Billies deal (deal) or take (take), times mult; only moves of a category (H physical, S special) or a type when given",
       "type": "object", "additionalProperties": false, "required": ["kind", "side", "mult"],
       "properties": {"kind": {"const": "damage"}, "side": {"enum": ["deal", "take"]}, "cat": {"enum": ["H", "S"]}, "type": {"type": "string", "minLength": 1}, "mult": {"type": "number", "minimum": 0, "maximum": 4}}
      },
      {
       "description": "heal: each place you walk into heals every Billie on your team that hasn't fainted by this share of its HP",
       "type": "object", "additionalProperties": false, "required": ["kind", "share"],
       "properties": {"kind": {"const": "heal"}, "share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
      },
      {
       "description": "payout: the payout's Research (research) or the share of their price items count at (itemShare), times mult",
       "type": "object", "additionalProperties": false, "required": ["kind", "what", "mult"],
       "properties": {"kind": {"const": "payout"}, "what": {"enum": ["research", "itemShare"]}, "mult": {"type": "number", "minimum": 0, "maximum": 4}}
      }
     ]
    }
   }
  }
 }
}
