{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "person.schema.json",
 "title": "game/data/people/<id>.json: how a person looks (a look, dressed from the wardrobe; the old colour keys beside it are ignored by the game)",
 "type": "object",
 "required": ["look"],
 "properties": {
  "look": {"type": "object"},
  "style": {"type": "string"},
  "figure": {"description": "characters track CH-3b: how this person's figure is shaped (logic/figure-kit.js): a head shape, a build, and how they move beyond the build's own gait (figure-pose.js figurePose)", "type": "object", "additionalProperties": false, "properties": {"head": {"enum": ["round", "oval", "square", "long", "pear", "heart"]}, "build": {"enum": ["average", "slim", "stocky", "round", "tall", "small", "athletic", "pear", "lanky", "elder"]}, "gait": {"type": "object", "additionalProperties": false, "properties": {"swing": {"type": "number", "minimum": 0, "maximum": 2}, "arms": {"type": "number", "minimum": 0, "maximum": 2}, "bounce": {"type": "number", "minimum": 0, "maximum": 3}, "lean": {"type": "number", "minimum": -0.4, "maximum": 0.4}, "head": {"type": "number", "minimum": -0.4, "maximum": 0.4}, "hang": {"type": "number", "minimum": 0, "maximum": 0.5}}}}},
  "creature": {"description": "a creature person (Kappi, a capybara): drawn from this rig (rigs-next.js, a bodyPlans.json form) instead of the look, standing ht metres tall", "type": "object", "required": ["rig"], "additionalProperties": false, "properties": {"rig": {"type": "string"}, "ht": {"type": "number", "exclusiveMinimum": 0, "maximum": 3}}}
 },
 "patternProperties": {
  "^(hair|hat|hat2|top|top2|bottom|shoe|pack|skin|tie)$": {"type": "string", "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$"}
 }
}
